# Node.js Auth & Operations Backend Service URL
# Prefer the server-only variable for the /backend-api proxy.
AUTH_API_URL=http://localhost:5000
# Optional browser-direct alternative; both origin and /api/v1 URLs are accepted.
# NEXT_PUBLIC_AUTH_API_URL=http://localhost:5000

# Python ML & Chatbot Backend Service URL
NEXT_PUBLIC_ML_API_URL=http://localhost:8000
CHATBOT_API_URL=http://localhost:8000
