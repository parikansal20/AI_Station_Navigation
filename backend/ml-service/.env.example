# ══════════════════════════════════════════════════════════════
# SAARTHI ML Service — Environment Variables
# Copy this file to .env and fill in real values
# ══════════════════════════════════════════════════════════════

# ── FastAPI / Project ─────────────────────────────────────────
PROJECT_NAME="SARTHI Station AI"
API_V1_STR="/api/v1"

# ── Redis (Caching & Rate Limiting) ──────────────────────────
# App gracefully falls back to in-memory cache if Redis is unreachable
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_PER_MINUTE=60
CROWD_CACHE_TTL_SECONDS=120

# ── Sarvam AI (Required for RAG Chatbot TTS / STT) ────────────
# Get your key at https://console.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Langfuse (Observability for RAG — Optional) ───────────────
# Get keys at https://cloud.langfuse.com/
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── CSRNet Crowd Analysis (Optional overrides) ────────────────
# CSRNET_APPLY_CLAHE=True
# CSRNET_DENOISE_IMAGE=False
# CSRNET_EMPTY_SPACE_PENALTY=True
# CSRNET_BIAS_FACTOR=0.6
# CSRNET_THRESHOLD_LOW=15
# CSRNET_THRESHOLD_MEDIUM=50
