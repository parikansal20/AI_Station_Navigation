# SAARTHI Auth & Operations Service Production Environment Variables (Render Account 1)

NODE_ENV=production
PORT=10000


# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/saarthi?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_token_key_here


# Allowed CORS Origin (Vercel Frontend URL)
CORS_ORIGIN=https://saarthi-passenger.vercel.app

# Nodemailer SMTP Configuration (Required for sending OTP verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_FROM="SAARTHI AI Security" <noreply@saarthi.gov.in>
