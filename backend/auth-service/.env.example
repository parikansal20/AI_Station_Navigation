# ══════════════════════════════════════════════════════════════
# SAARTHI Auth Service — Local Development Template (.env.example)
# Copy this file to .env and fill in real values
# ══════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/saarthi_auth

# JWT Token Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Inter-service Communication
ML_SERVICE_URL=http://localhost:8000

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:3000

# Nodemailer SMTP Email Authentication & OTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SAARTHI AI Security" <noreply@saarthi.gov.in>
